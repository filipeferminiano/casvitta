# Cloud Build upload (gcloud builds submit). Keep it small: no deps, builds, API or mockups.
.git/
.gcloudignore
node_modules/
**/node_modules/
**/.next/
**/.turbo/
storybook-static/
playwright-report/
test-results/
apps/api/*
# The web parity tests type-check against the API's shared vectors.
!apps/api/tests/
apps/api/tests/*
!apps/api/tests/fixtures/
docs/
infra/postgres/
.env
.env.*
!.env.example
