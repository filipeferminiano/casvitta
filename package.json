{
  "name": "casvitta",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @casvitta/ui storybook",
    "build-storybook": "pnpm --filter @casvitta/ui build-storybook",
    "api:gen": "pnpm --filter @casvitta/api-client generate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
