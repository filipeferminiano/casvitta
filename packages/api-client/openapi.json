{
  "openapi": "3.1.0",
  "info": {
    "title": "Casvitta API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the process is up.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Readiness: dependencies answer.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/interest": {
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Create Interest",
        "description": "Capture pages: store the signup and ask for WhatsApp double opt-in. No auth.",
        "operationId": "createInterestSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AgencySignup"
                  },
                  {
                    "$ref": "#/components/schemas/OwnerListingSignup"
                  },
                  {
                    "$ref": "#/components/schemas/DeveloperSignup"
                  },
                  {
                    "$ref": "#/components/schemas/InvestorInstitutionalSignup"
                  },
                  {
                    "$ref": "#/components/schemas/RentalAdminSignup"
                  },
                  {
                    "$ref": "#/components/schemas/AuctionSignup"
                  }
                ],
                "title": "Payload",
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "agency": "#/components/schemas/AgencySignup",
                    "owner_listing": "#/components/schemas/OwnerListingSignup",
                    "developer": "#/components/schemas/DeveloperSignup",
                    "investor_institutional": "#/components/schemas/InvestorInstitutionalSignup",
                    "rental_admin": "#/components/schemas/RentalAdminSignup",
                    "auction": "#/components/schemas/AuctionSignup"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterestSignupAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/interest": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Interest",
        "operationId": "listInterestSignups",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/InterestKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(json|csv)$",
              "default": "json",
              "title": "Format"
            }
          },
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InterestSignupOut"
                  },
                  "title": "Response Listinterestsignups"
                }
              },
              "text/csv": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
