    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.7",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
