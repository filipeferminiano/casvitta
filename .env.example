# Copy to .env and adjust. Every variable the apps read is listed here.
# Integrations default to fake adapters when FAKE_INTEGRATIONS=true or credentials are missing.

# --- API (apps/api) ---
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production
DATABASE_URL=postgresql+asyncpg://casvitta:casvitta@localhost:5432/casvitta
TEST_DATABASE_URL=postgresql+asyncpg://casvitta:casvitta@localhost:5432/casvitta_test
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000
JWT_SECRET=change-me-in-production
ADMIN_TOKEN=                       # admin endpoints (/v1/admin/*) until real auth; empty = disabled
INTEREST_RATE_LIMIT_PER_MINUTE=5

FAKE_INTEGRATIONS=true

# LLM (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Meta (ads + pages)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email / SMS
EMAIL_FROM=Casvitta <nao-responda@casvitta.com.br>
EMAIL_API_KEY=
SMS_API_KEY=

# Business configuration (money in integer cents, rates in basis points)
PLAN_ESSENCIAL_PRICE_CENTS=19700
PLAN_ESSENCIAL_MAX_ACTIVE_PROPERTIES=3
PLAN_PROFISSIONAL_PRICE_CENTS=39700
PLAN_PROFISSIONAL_MAX_ACTIVE_PROPERTIES=15
MIN_DAILY_BUDGET_CENTS=2000
FINANCING_ILLUSTRATIVE_ANNUAL_RATE_BPS=1150

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical public origin (https://casvitta.com.br in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCKS=true         # screens read the in-memory demo store (Milestone 0.5)
NEXT_PUBLIC_MIN_DAILY_BUDGET_CENTS=2000
NEXT_PUBLIC_COMPANY_CRECI=[NÚMERO]  # Casvitta's CRECI-J, shown in the site footer
NEXT_PUBLIC_COMPANY_WHATSAPP=+5511927408912
ROOT_DOMAIN=localhost:3000          # casvitta.com.br in production
APP_SUBDOMAIN=app
